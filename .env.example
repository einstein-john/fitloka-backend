# Copy to .env and fill in secrets. Docker Compose loads .env automatically.
#
# cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=3000
VERSION=1.0.0
SERVICE=fitlokal-api
# Exact browser origins (comma-separated). http://127.0.0.1:5173 ≠ http://localhost:5173
# Use * only for local experiments (do not use with credentials: include on the client).
#
# Deployed API + local frontend: include BOTH local dev origins so the browser is allowed
# (e.g. Vite on localhost calling https://your-api.example.com). Also add your prod site if needed:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Trust proxy (recommended behind reverse proxy / Docker: 1 or true)
# TRUST_PROXY=1

# --- Database (PostgreSQL) ---
# Sequelize CLI uses DB_*; default port in app Joi is 3306—use 5432 for Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fitloka
DB_SYNC=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Resend (magic link + email confirmation; leave API key empty to skip sending) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_EMAIL_FROM=onboarding@resend.dev

# Frontend URLs that receive ?token=... (adjust to your app)
MAGIC_LINK_REDIRECT_URL=http://localhost:5173/auth/magic-link
EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:5173/auth/email-confirmation

# --- Rate limiting (optional overrides) ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_REQUESTS=20

# --- Seeders (optional; see seeders/*.js) ---
# SEED_DEV_API_KEY=...   # max 32 chars; default used if unset
# SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_SHOPPER_PASSWORD=ChangeMe123!

# --- OpenTelemetry (optional; tracing scripts) ---
# OTEL_SERVICE_NAME=fitlokal-api
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# HONEYCOMB_API_KEY=
